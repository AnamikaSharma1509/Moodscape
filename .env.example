# ==============================================================================
# MoodScape Environment Configuration Template
# ==============================================================================

# Backend Configuration (FastAPI)
HOST=0.0.0.0
PORT=8000
TMDB_API_KEY=your_tmdb_api_key_here
DEFAULT_REGION=IN

# Frontend Configuration (Vite + React)
# When running locally or through Cloudflare Tunnel proxy, leave empty or set to /api
VITE_API_URL=/api

# Google Identity Services OAuth 2.0 Client ID (Web Application)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins: http://localhost:5173, https://your-tunnel.trycloudflare.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
